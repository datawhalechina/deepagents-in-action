# Offline is the default. Select live explicitly in the runner or COURSE_MODE.
# SiliconFlow (optional live experiments)
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
MODEL_NAME=Qwen/Qwen2.5-7B-Instruct

# For another OpenAI-compatible provider, configure all three together:
# MODEL_API_KEY=
# MODEL_BASE_URL=
# MODEL_NAME=

# Chapter 2 research assistant, live mode only (install with --extra search).
# TAVILY_API_KEY=

# Optional tracing; not required for the local in-memory Agent Server.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
