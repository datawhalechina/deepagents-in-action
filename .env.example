# Offline is the default. Select live explicitly in the runner or COURSE_MODE.
# SiliconFlow (optional live experiments)
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# Choose an exact model ID from the chapter's live notes / notebooks/README.md.
# Verified for ch07/ch09/ch10/ch14: Qwen/Qwen3-Coder-30B-A3B-Instruct
# Also verified for ch14: deepseek-ai/DeepSeek-V3.2 (without the Pro/ prefix).
# Other chapters are pending live verification. There is no implicit model default.
MODEL_NAME=

